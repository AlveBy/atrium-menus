{
    "name": "alveby/atrium-menus",
    "description": "Menus for Atrium: per site and language, a drag-and-drop tree of links to any record, items that unfold a module's sections",
    "type": "atrium-module",
    "license": "MIT",
    "homepage": "https://github.com/AlveBy/atrium",
    "support": {
        "issues": "https://github.com/AlveBy/atrium/issues",
        "source": "https://github.com/AlveBy/atrium"
    },
    "keywords": [
        "laravel",
        "admin",
        "cms",
        "menu",
        "navigation",
        "multisite",
        "i18n"
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "alveby/atrium": "^0.2"
    },
    "require-dev": {
        "alveby/atrium-theme": "^0.2",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5"
    },
    "suggest": {
        "alveby/atrium-theme": "Draws the header and footer menus on the site",
        "alveby/atrium-catalog": "Catalog sections to unfold in a menu",
        "alveby/atrium-pages": "Pages to link to and unfold in a menu"
    },
    "autoload": {
        "psr-4": {
            "Atrium\\Menus\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Atrium\\Menus\\Tests\\": "tests/"
        }
    },
    "extra": {
        "atrium": {
            "resources": [
                "Atrium\\Menus\\Models\\Menu"
            ],
            "migrations": "database/migrations",
            "demo": "Atrium\\Menus\\Database\\MenusDemoSeeder"
        },
        "laravel": {
            "providers": [
                "Atrium\\Menus\\MenusServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
